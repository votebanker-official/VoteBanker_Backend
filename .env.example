# Copy to `.env` for local development. NEVER commit `.env`.
# Real secret values live in Railway -> VoteBanker_Backend -> Variables.

PORT=5000

# Comma-separated browser origins allowed to call the API.
# Leave empty locally (allows all). Production: https://votebanker-frontend.vercel.app
CORS_ORIGINS=

# --- Twilio (Console -> Account info, and Verify -> Services -> VoteBanker) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Set to true only after a WhatsApp sender is configured on the Verify service.
# While false, "Continue with WhatsApp" shows "not available yet".
WHATSAPP_OTP_ENABLED=false

# --- Supabase (Project Settings -> API Keys) ---
# URL and publishable key are public by design (they ship in every web app).
SUPABASE_URL=https://zlqgxqngaqsseksosfle.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_UoGvdOilwkXSu3cv-ou_eQ_qOSZy-nn
# SECRET key: server-only. Never put it in the frontend or in git.
SUPABASE_SECRET_KEY=
