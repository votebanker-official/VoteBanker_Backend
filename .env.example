# Copy to `.env` for local development. NEVER commit `.env`.
# Real secret values live in Railway -> VoteBanker_Backend -> Variables.

PORT=5000

# Comma-separated browser origins allowed to call the API.
# Leave empty locally (allows all). Production: https://votebanker-frontend.vercel.app
CORS_ORIGINS=

# --- Twilio (Console -> Account info, and Verify -> Services -> VoteBanker) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Set to true only after a WhatsApp sender is configured on the Verify service.
# While false, "Continue with WhatsApp" shows "not available yet".
WHATSAPP_OTP_ENABLED=false

# --- Facebook and Instagram sign-in (Meta for Developers) ---
# Facebook Login and Instagram Login on the same Meta app.
# Redirect URI to register in Meta (exact match):
#   https://votebankerbackend-production.up.railway.app/api/auth/oauth/callback
# Instagram Login uses the Instagram app id from the Instagram product settings.
# If INSTAGRAM_APP_ID is empty, Instagram falls back to META_APP_ID.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Public origin of this API. Leave empty to use the request host.
PUBLIC_API_URL=
# Browser origin that may receive the sign-in return. Also listed in CORS_ORIGINS.
FRONTEND_URL=

# --- Social Media Setup connections (same callback as sign-in) ---
# Redirect URI (exact match) for Meta, Google, and X:
#   https://votebankerbackend-production.up.railway.app/api/auth/oauth/callback
# WhatsApp Embedded Signup configuration id from Meta Business.
WHATSAPP_CONFIG_ID=
# Google OAuth client used by YouTube and Email connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X / Twitter OAuth 2.0 client. Leave empty until X API access is granted.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional extra key for encrypting stored social tokens. Falls back to SUPABASE_SECRET_KEY.
SOCIAL_TOKEN_KEY=

# --- Supabase (Project Settings -> API Keys) ---
# URL and publishable key are public by design (they ship in every web app).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SECRET key: server-only. Never put it in the frontend or in git.
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Speech drafting. Leave the key empty to use the development composer.
# Cloud: an OpenAI-compatible /v1 root, for example https://api.openai.com/v1 and gpt-4o-mini.
# Local Ollama: http://127.0.0.1:11434 (no /v1) and a model such as gemma3:4b. Any non-empty key works.
SPEECH_AI_API_KEY=
SPEECH_AI_BASE_URL=https://api.openai.com/v1
SPEECH_AI_MODEL=gpt-4o-mini

# Professional website generator (POST /api/websites/generate).
# Falls back to SPEECH_AI_* / OPENAI_API_KEY when WEBSITE_AI_* is empty.
# If no key is set, generation returns website_ai_not_configured (no silent fake AI).
# Local Ollama: WEBSITE_AI_BASE_URL=http://127.0.0.1:11434 WEBSITE_AI_MODEL=gemma3:4b
WEBSITE_AI_API_KEY=
WEBSITE_AI_BASE_URL=
WEBSITE_AI_MODEL=

# --- Openprovider (Control panel -> Contact persons -> API access) ---
# Username/password of the contact person with API access enabled.
# Never put these in Flutter, browser code, or git.
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
# Optional overrides. Defaults match the current Openprovider REST API.
OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1
# Do NOT set OPENPROVIDER_IP. Login always uses 0.0.0.0.
# Railway outbound IPs change often. In Openprovider RCP → Contact persons → API:
# leave whitelist AND blacklist completely EMPTY (do not paste a single Railway IP).
# Per Openprovider HTTP request (not the whole search).
OPENPROVIDER_TIMEOUT_MS=30000
# 0 = no cap (use full Openprovider TLD catalog when allTlds/omitted extensions).
OPENPROVIDER_MAX_EXTENSIONS=0
# Openprovider rejects batches larger than ~15.
OPENPROVIDER_BATCH_SIZE=15
# Parallel /domains/check batches during a full-catalog search.
OPENPROVIDER_CHECK_CONCURRENCY=4

# --- VRM electoral-roll import (server-side PDF OCR; optional) ---
# Absolute path to a local PDF. Never commit the PDF to git.
VRM_PDF_PATH=
# Must be "true" to enable POST /api/vrm/import/preview-pdf.
VRM_ALLOW_SERVER_PDF_IMPORT=false
# Optional tool overrides for OCR on Windows/Linux.
# TESSERACT_PATH=
# PDFTOPPM_PATH=
# POPPLER_BIN_DIR=
