# Speech drafting. Leave the key empty to use the development composer.
# Cloud: an OpenAI-compatible /v1 root, for example https://api.openai.com/v1 and gpt-4o-mini.
# Local Ollama: http://127.0.0.1:11434 (no /v1) and a model such as gemma3:4b. Any non-empty key works.
SPEECH_AI_API_KEY=
SPEECH_AI_BASE_URL=https://api.openai.com/v1
SPEECH_AI_MODEL=gpt-4o-mini
